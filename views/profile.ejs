<!doctype html>
<html>
<head>
    <title>Body Script</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="profile.css">
</head>
<body>
<div class="container">

    <div class="page-header text-center">
        <h1>Profile Page</h1>
        <a href="/logout" class="btn btn-default btn-sm">Logout</a>
    </div>

    <div class="row">

        <!-- LOCAL INFORMATION -->
        <div class="col-sm-6">
          <h3>Tell me how to do you really feel today</h3>
          <ul class="messages">
          <% for(var i=0; i<messages.length; i++) {%>
            <li class="message">
              <span data-msg-id="<%= messages[i]._id %>"><%= messages[i].name %></span>
              <span><%= messages[i].msg %></span>
              
              <!-- <span><i class="fa fa-thumbs-up" aria-hidden="true"></i></span>
              <span><i class="fa fa-thumbs-down" aria-hidden="true"></i></span> -->
              <span><i class="fa fa-trash" aria-hidden="true"></i></span>
            </li>
          <% } %>
          </ul>
          <label for="mood-select">Choose your mood:</label>
            <select name="mood" id="mood-select" required class="border border-gray-300 rounder-lg px-4 py-2 bg-white">
                <option value="" disabled selected>--Record your mood today</option>
                <option value="happy">Happy</option>
                <option value="calm">Calm</option>
                <option value="sad">Sad</option>
                <option value="mad">Mad</option>
            </select>
         



          <h2>Write Down what happen today</h2>
        <% if (user.local.email) { %>
          <form action="/messages" method="POST">
            <!-- <input type="text" value="<%= user.local.email %>" name="name"> -->
            <input type="text" placeholder="message" name="msg">
            <input type="date" id="calendar" name="calendar">
            <button type="submit">Submit</button>
          </form>
        </div>
        <% } %>

</div>
<a href="/login" >login</a>
<script src="main.js"></script>

</body>
</html>
